{
  "name": "fly-drone",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "setup": "./scripts/setup.sh",
    "dev": "scripts/venv.sh fly-drone serve --accepted --current",
    "predev": "yarn py:build && yarn build",
    "dev:policy": "scripts/venv.sh fly-drone serve --policy",
    "web:dev": "vite web --host 127.0.0.1",
    "build": "vite build web",
    "typecheck": "tsc --noEmit -p web",
    "test": "vitest run --root web",
    "format": "prettier --write \"web/src/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\" \"docs/**/*.md\" \"eslint.config.js\"",
    "format:check": "prettier --check \"web/src/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\" \"docs/**/*.md\" \"eslint.config.js\"",
    "lint": "eslint web/src scripts",
    "lint:fix": "eslint web/src scripts --fix",
    "rs:fmt": "cargo fmt --all",
    "rs:fmt:check": "cargo fmt --all --check",
    "rs:lint": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "rs:test": "cargo test -p brain-core --locked",
    "rs:bench": "cargo run --release --locked -p brain-core --bin brain-bench",
    "py:fmt": "scripts/venv.sh ruff format python tests scripts",
    "py:fmt:check": "scripts/venv.sh ruff format --check python tests scripts",
    "py:lint": "scripts/venv.sh ruff check python tests scripts",
    "py:lint:fix": "scripts/venv.sh ruff check --fix python tests scripts",
    "py:build": "scripts/venv.sh maturin develop --release --skip-install",
    "py:test": "PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 scripts/venv.sh python -m pytest -q",
    "smoke": "scripts/venv.sh fly-drone baseline --seconds 2 --output runs/smoke-baseline.json",
    "browser:check": "node scripts/browser-check.mjs",
    "assay": "scripts/venv.sh fly-drone assay",
    "calibrate": "scripts/venv.sh fly-drone calibrate",
    "train": "scripts/venv.sh fly-drone train",
    "evaluate": "scripts/venv.sh fly-drone evaluate",
    "prep": "yarn format && yarn lint:fix && yarn rs:fmt && yarn py:fmt && yarn py:lint:fix && yarn typecheck && yarn rs:lint && yarn py:lint && yarn py:build && yarn build",
    "ci": "yarn format:check && yarn lint && yarn rs:fmt:check && yarn py:fmt:check && yarn py:lint && yarn typecheck && yarn rs:lint && yarn rs:test && yarn py:build && yarn py:test && yarn test && yarn build && yarn smoke"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22",
    "@types/three": "0.185.4",
    "eslint": "^9",
    "globals": "^15",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
